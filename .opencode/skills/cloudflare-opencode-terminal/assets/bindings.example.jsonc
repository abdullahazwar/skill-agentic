{
  // Ambil bagian yang diperlukan. Ini fragmen, bukan config proyek lengkap.
  // Ganti placeholder dengan ID yang diperoleh dari akun yang benar.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "aplikasi-db",
    "database_id": "<ID-DATABASE>",
    "migrations_dir": "migrations"
  }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "<ID-KV>" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "aplikasi-files" }],
  "ai": { "binding": "AI" }
}
