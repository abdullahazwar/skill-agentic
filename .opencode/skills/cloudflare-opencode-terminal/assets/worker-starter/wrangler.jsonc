{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-worker-starter",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "vars": { "APP_ENV": "development" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/healthz"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
